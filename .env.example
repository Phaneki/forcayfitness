# Puerto HTTP (Render asigna PORT automáticamente, ej. 10000)
PORT=3000
NODE_ENV=development

# URL de conexión PostgreSQL de Render (Internal o External Database URL)
DATABASE_URL=postgresql://forca_user:forca_pass@localhost:5432/forca_fitness

# Opcional: forzar SSL ('true' para Render External URL, 'false' para local sin SSL)
# DATABASE_SSL=true

# Secreto JWT para tokens de sesión SSO (Render lo autogenera con generateValue: true)
JWT_SECRET=cambia_este_secreto_jwt_en_produccion_forca_fitness

# Opcional: clave de LLM externo (OpenAI o Gemini). Si no se define, el Agente IA usa el motor RAG+MCP local conectado a PostgreSQL.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Opcional: clave HMAC para verificar webhooks reales de Culqi / Mercado Pago
# WEBHOOK_SECRET=

